# ==================== LLM API 配置 ====================
# 主LLM配置 (支持 DeepSeek, OpenAI, Qwen 等 OpenAI 兼容接口)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 备用LLM配置 (可选)
# LLM_BACKUP_API_KEY=your_backup_api_key
# LLM_BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BACKUP_MODEL=qwen-plus

# 兼容旧配置 (如果使用 OpenAI)
# OPENAI_API_KEY=your_openai_api_key

# ==================== 搜索 API 配置 ====================
# Tavily 搜索 API (https://tavily.com 注册获取)
TAVILY_API_KEY=your_tavily_api_key_here

# ==================== PDF 处理配置 ====================
# MinerU 配置
MINERU_USE_GPU=true
# MINERU_MODEL_DIR=/path/to/models  # 可选，自定义模型目录

# ==================== 应用配置 ====================
HOST=0.0.0.0
PORT=7860
DEBUG=true

# ==================== 文件目录配置 ====================
UPLOAD_DIR=uploads
OUTPUT_DIR=output
TEMP_DIR=temp

# ==================== 已废弃配置 (保留兼容性) ====================
# PDFDEAL_API_KEY=  # 已废弃，使用 MinerU 替代
# CLAUDE_CODE_COMMAND=claude -p  # 已废弃，使用 LLM API 替代
# SERVER_GET_KEYWORD=  # 已废弃，使用本地 LLM 替代
# SERVER_SEARCH_LINK=  # 已废弃，使用 Tavily 替代
# SERVER_SUMMARY=  # 已废弃，使用本地 LLM 替代
# SERVER_KNOWLEDGE=  # 已废弃，使用本地 LLM 替代
# SERVER_GEN_BLOG=  # 已废弃，使用本地 LLM 替代

